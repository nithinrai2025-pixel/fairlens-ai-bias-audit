# Database: use PostgreSQL for persistent hosted deployments; SQLite is for local development only.
DATABASE_URL="file:./dev.db"
# Provider keys are read only on the server. Leave blank when using demo/manual mode.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"
# Optional: set a long random value in production to protect write endpoints with a shared app token.
FAIRLENS_API_TOKEN=""
